{
  "manifest_version": 3,
  "name": "Curb Cut",
  "version": "1.0.0",
  "description": "Applies accessibility repairs backed by Kane task recordings or local browser measurements.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "downloads",
    "activeTab",
    "clipboardWrite"
  ],
  "host_permissions": [
    "http://127.0.0.1:4317/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Curb Cut",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "im-stuck": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "MacCtrl+Shift+U"
      },
      "description": "Capture an accessibility barrier"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "runtime.js",
        "lib/constants.js",
        "lib/match.js",
        "lib/validate.js",
        "lib/select.js",
        "lib/sensitive.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
