{
  "manifest_version": 3,
  "name": "Curb Cut",
  "version": "1.0.0",
  "description": "Applies accessibility repairs backed by Kane task recordings or local browser measurements.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "downloads",
    "activeTab",
    "clipboardWrite",
    "scripting",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Curb Cut",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "instant-fix": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Try an instant accessibility repair"
    },
    "im-stuck": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "MacCtrl+Shift+U"
      },
      "description": "Capture an accessibility barrier"
    },
    "match-mouse": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Try matching a hover menu with the keyboard"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["fonts/Overpass.ttf", "fonts/InterTight.ttf"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "runtime.js",
        "lib/constants.js",
        "lib/match.js",
        "lib/validate.js",
        "lib/select.js",
        "lib/sensitive.js",
        "content.js",
        "instant-content.js",
        "naming-content.js",
        "stuck-content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
