          "declarations": "visibility: visible; opacity: 1; margin-top: 15px; transition-delay: 0s; box-shadow: rgb(221, 221, 221) 0px 0px 4px 1px;",
          "conditions": [
            "(max-width: 991px)"
          ]
        }
      ]
    }
  }
}
